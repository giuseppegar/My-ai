# Copia in .env.local (locale) oppure .env (Docker). Non inserire segreti nel client.
APP_URL=http://localhost:3000
# Facoltativo: elenco di origin separati da virgola (es. dominio principale + duckdns + dev).
# Se assente, vale APP_URL. Serve per il controllo Origin delle richieste che modificano dati.
APP_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Obbligatorio: UUID del marcatore myai_instance_id() dello stack DEDICATO.
SUPABASE_INSTANCE_ID=
# Nome distinto dalle altre app, anche quando condividono hostname ma non porta.
SUPABASE_AUTH_COOKIE_NAME=myai-auth-token
# SOLO per eliminazione account, su un progetto Supabase dedicato a My ai.
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_AUTH_ACCOUNT_DELETION=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Nome configurabile: verifica disponibilità e prezzi nel tuo account DeepSeek.
DEEPSEEK_MODEL=deepseek-flash
# Abilitare SOLO con un modello/endpoint che supporta immagini; non abilita la visione di un modello testuale.
DEEPSEEK_VISION=false
# Ricerca web (facoltativa): la domanda viene inviata al servizio configurato solo quando
# premi “Cerca nel web”. I link incollati vengono aperti dal server con protezione
# della rete locale anche senza chiave. WEB_FETCH_ALLOW_PRIVATE è SOLO per sviluppo/test.
# Provider: 'openrouter' (plugin web, stessa chiave delle immagini) o 'tavily'.
# Con OpenRouter il costo osservato è ≈0,028 USD/ricerca (gemini-3.8-flash, reasoning spento).
WEB_SEARCH_PROVIDER=tavily
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_WEB_MODEL=google/gemini-3.8-flash
WEB_DAILY_LIMIT=10
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=3
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_ALLOW_PRIVATE=false
# Generazione immagini (facoltativa): endpoint OpenAI-compatible /images/generations.
# Il provider riceve solo il prompt. Nessuna chiamata AI intermedia.
# Esempio OpenRouter: IMAGE_BASE_URL=https://openrouter.ai/api/v1 e IMAGE_MODEL=openai/gpt-5-image
# Verifica sempre i modelli disponibili: il catalogo cambia.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_DAILY_LIMIT=5
# Video OpenRouter: partono spenti per non addebitare credito a sorpresa.
# In produzione (14 set 2026) sono attivi con veo-3.1-lite, 4s, 720p, senza audio: costo reale
# osservato 0,12 USD per generazione. Verificare il listino prima di cambiare modello o durata.
# Usa OPENROUTER_API_KEY; fallback IMAGE_API_KEY solo con IMAGE_BASE_URL su OpenRouter.
# Endpoint fisso https://openrouter.ai/api/v1/videos. Nessuna chiamata DeepSeek intermedia.
VIDEO_ENABLED=false
VIDEO_MODEL=google/veo-3.1-lite
VIDEO_DURATION_SECONDS=4
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=16:9
VIDEO_DAILY_LIMIT=2
# Senza audio; catalogo e parametri verificati prima di ogni nuovo job. Max MP4 50 MB.
# OCR locale: Tesseract (ita+eng) e Poppler devono essere installati.
# L’immagine Docker li include e abilita OCR per default se questa variabile è assente.
# In locale, impostare true solo dopo aver installato gli strumenti.
DOCUMENT_OCR_ENABLED=false
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1600
# Tariffe CAUTELATIVE configurabili, USD per milione di token, non preventivo del provider.
AI_INPUT_USD_PER_MILLION=1
AI_OUTPUT_USD_PER_MILLION=5
AI_DAILY_CALL_LIMIT=50

# FACOLTATIVO: embeddings bge-m3 (1024 dimensioni) su un servizio Ollama di fiducia.
# Non viene installato né avviato automaticamente. Nessun fallback a servizi cloud.
OLLAMA_BASE_URL=
EMBEDDING_MODEL=bge-m3
